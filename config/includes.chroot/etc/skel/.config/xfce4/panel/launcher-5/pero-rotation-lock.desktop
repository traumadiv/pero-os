[Desktop Entry]
Type=Application
Name=Rotation lock
Name[ru]=Блокировка поворота
Comment=Lock or unlock automatic screen rotation
Comment[ru]=Заблокировать или разрешить автоповорот экрана
Exec=pero-rotate lock
Icon=rotation-locked-symbolic
Terminal=false
Actions=Rotate;

[Desktop Action Rotate]
Name=Rotate 90°
Name[ru]=Повернуть на 90°
Exec=pero-rotate next
