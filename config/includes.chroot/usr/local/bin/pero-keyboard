#!/bin/bash
# pero-keyboard — show/hide the on-screen keyboard (Onboard), starting it if needed.

if ! dbus-send --session --print-reply --type=method_call --dest=org.onboard.Onboard \
	/org/onboard/Onboard/Keyboard org.onboard.Onboard.Keyboard.ToggleVisible >/dev/null 2>&1; then
	setsid onboard >/dev/null 2>&1 &
fi
