#!/bin/bash
# pero-hwinfo — collect a hardware report (touch, Wi-Fi, sound, sensors, firmware)
# into ~/pero-hwinfo.txt so problems on a specific tablet can be fixed quickly.

OUT="$HOME/pero-hwinfo.txt"
[ "$(id -u)" -ne 0 ] && exec pkexec env HOME="$HOME" DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" "$0" "$@"

section() { printf '\n===== %s =====\n' "$1"; }

{
	echo "Pero OS hardware report — $(date -R)"

	section "DMI"
	for f in sys_vendor product_name product_version board_vendor board_name bios_version bios_date; do
		printf '%-16s %s\n' "$f" "$(cat /sys/class/dmi/id/$f 2>/dev/null)"
	done

	section "Kernel / firmware"
	uname -a
	cat /proc/cmdline
	printf 'UEFI bitness: %s\n' "$(cat /sys/firmware/efi/fw_platform_size 2>/dev/null || echo 'BIOS / unknown')"

	section "ACPI devices (touch / sensors / audio codecs)"
	for d in /sys/bus/acpi/devices/*; do
		hid=$(cat "$d/hid" 2>/dev/null) || continue
		status=$(cat "$d/status" 2>/dev/null)
		case "$hid" in
			MSSL*|GDIX*|GSL*|ELAN*|FTSC*|SIS*|NVT*|CHPN*|ILTK*|HIMX*|\
			BOSC*|KIOX*|SMO*|NSA*|STK*|ACCL*|MXC*|BMA*|\
			10EC*|ESSX*|INT343*|808622A8|80860F28|OBDA*|BCM*)
				echo "$hid  status=$status  $(basename "$d")" ;;
		esac
	done

	section "I2C devices"
	for d in /sys/bus/i2c/devices/*; do
		printf '%s  %s  driver=%s\n' "$(basename "$d")" "$(cat "$d/name" 2>/dev/null)" \
			"$(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)"
	done

	section "Input devices"
	grep -E '^(N|H):' /proc/bus/input/devices

	section "PCI"
	lspci -nnk
	section "USB"
	lsusb
	section "SDIO"
	for d in /sys/bus/sdio/devices/*; do
		echo "$(basename "$d") vendor=$(cat "$d/vendor" 2>/dev/null) device=$(cat "$d/device" 2>/dev/null)"
	done

	section "Network"
	rfkill list
	ip -br link

	section "Sound"
	aplay -l 2>&1
	cat /proc/asound/cards

	section "IIO sensors"
	for d in /sys/bus/iio/devices/iio:device*; do
		echo "$(basename "$d"): $(cat "$d/name" 2>/dev/null)  mount_matrix=$(cat "$d/in_mount_matrix" 2>/dev/null)"
	done

	section "Battery"
	upower -i "$(upower -e | grep -m1 BAT)" 2>/dev/null
	for s in /sys/class/power_supply/*; do
		echo "$(basename "$s"): type=$(cat "$s/type" 2>/dev/null) status=$(cat "$s/status" 2>/dev/null)" \
			"capacity=$(cat "$s/capacity" 2>/dev/null) online=$(cat "$s/online" 2>/dev/null)" \
			"power_now=$(cat "$s/power_now" 2>/dev/null) current_now=$(cat "$s/current_now" 2>/dev/null)"
	done
	powerprofilesctl get 2>&1

	section "Power log (last hour) and how the last boot ended"
	tail -n 60 /var/log/pero-power.log 2>/dev/null
	journalctl -b -1 -n 30 --no-pager 2>/dev/null

	section "Sleep / idle"
	echo "mem_sleep: $(cat /sys/power/mem_sleep 2>/dev/null)"
	mount -t debugfs none /sys/kernel/debug 2>/dev/null
	cat /sys/kernel/debug/pmc_atom/sleep_state 2>/dev/null
	cat /sys/kernel/debug/pmc_atom/dev_state 2>/dev/null | grep -v 'D0i3\|Disabled' | head -n 40
	journalctl -b -1 -k --no-pager 2>/dev/null | grep -iE 'PM: suspend|s2idle|wakeup' | tail -n 20
	echo "--- busiest processes"
	ps -eo pcpu,pmem,comm --sort=-pcpu | head -n 12

	section "Boot loader"
	efibootmgr -v 2>&1
	for d in /boot/efi /efi; do
		mountpoint -q "$d" && find "$d/EFI" -maxdepth 2 -printf '%p %s\n' 2>/dev/null
	done
	cat /boot/efi/EFI/BOOT/grub.cfg 2>/dev/null

	section "Missing firmware / errors (dmesg)"
	dmesg | grep -iE 'firmware|silead|goodix|touch|rtl|r8723|brcm|snd|sof|sst|i915.*(error|fail)|error|fail' | tail -n 150
} >"$OUT" 2>&1

[ -n "$SUDO_USER$PKEXEC_UID" ] && chown "${PKEXEC_UID:-$SUDO_USER}" "$OUT" 2>/dev/null
echo "Отчёт сохранён: $OUT"
command -v notify-send >/dev/null && sudo -u "#${PKEXEC_UID:-0}" DISPLAY="$DISPLAY" \
	DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${PKEXEC_UID:-0}/bus" \
	notify-send -i dialog-information "Отчёт о железе готов" "$OUT" 2>/dev/null
exit 0
