#!/bin/sh
# pero-install — start Calamares with sane scaling.
# Debian's wrapper goes through pkexec, which drops the environment, so the root
# Calamares picks up Xft.dpi=144 and draws 1.5x fonts in 1x widgets. Here the
# whole UI is scaled evenly instead (the live user has passwordless sudo).

sudo mv /etc/fstab /etc/fstab.orig.calamares 2>/dev/null

xhost +si:localuser:root >/dev/null
sudo env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" \
	QT_AUTO_SCREEN_SCALE_FACTOR=0 QT_SCALE_FACTOR=1.25 QT_FONT_DPI=96 \
	calamares "$@"
xhost -si:localuser:root >/dev/null

sudo mv /etc/fstab.orig.calamares /etc/fstab 2>/dev/null
