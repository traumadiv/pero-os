#!/bin/sh
# pero-games — RetroArch with the "performance" power profile held while it runs.
# Cherry Trail drops its clocks fast on the balanced profile, which costs PSP/N64 games.
# /etc/pero/retroarch.cfg goes on top of the user's settings: what keeps it stable.

GAMES="$HOME/Игры"
for d in NES SNES "Game Boy" GBA "Sega" PS1 PSP "Nintendo DS" N64 Dreamcast "Аркады"; do
	mkdir -p "$GAMES/$d"
done
LOG="$HOME/.cache/retroarch"
mkdir -p "$LOG"

# PPSSPP's fonts and system dialogs must match the PPSSPP core: refresh the
# user's copy whenever pero-cores installed a different bundle
SYS="$HOME/.config/retroarch/system"
SHARED=/usr/share/pero/retroarch-system
if [ -d "$SHARED/PPSSPP" ] && ! cmp -s "$SHARED/VERSION" "$SYS/.pero-cores"; then
	mkdir -p "$SYS"
	rm -rf "$SYS/PPSSPP"
	cp -r "$SHARED/PPSSPP" "$SYS/" && cp "$SHARED/VERSION" "$SYS/.pero-cores"
fi

# pero-touchd lets touches straight through while this pid is alive: the
# on-screen gamepad must not wait for gestures (a held button became a right click)
FLAG="${XDG_RUNTIME_DIR:-/tmp}/pero-game"
echo $$ >"$FLAG"
# Full CPU and GPU clocks for the game's lifetime (pero-cpu-boost): the
# "performance" profile below does nothing on this Atom
BOOST=/run/pero-boost/$$
[ -d /run/pero-boost ] && : >"$BOOST"
trap 'rm -f "$FLAG" "$BOOST"' EXIT
trap 'exit 130' INT TERM HUP

set -- retroarch --appendconfig=/etc/pero/retroarch.cfg "$@"
# Not every machine offers "performance" (VMs, some firmware): then just run
if powerprofilesctl list 2>/dev/null | grep -q 'performance:'; then
	set -- powerprofilesctl launch -p performance -r "Игры" -- "$@"
fi
"$@"
code=$?
# Killed by a signal (crash): say so instead of just vanishing
if [ "$code" -gt 128 ]; then
	notify-send -i retroarch "Игры закрылись с ошибкой" \
		"Журнал: ~/.cache/retroarch/retroarch.log — его соберёт «Отчёт о железе»" 2>/dev/null
fi
exit "$code"
