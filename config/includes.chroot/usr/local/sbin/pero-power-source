#!/bin/sh
# pero-power-source — follow the charger: power-saver on battery, balanced on AC.
# Run by udev (70-pero-power.rules) when the charger is plugged in or out, and
# once at boot. A profile held by an app (pero-games asks for performance) is
# left to power-profiles-daemon: it only changes the base profile.

online=0
for s in /sys/class/power_supply/*; do
	[ "$(cat "$s/type" 2>/dev/null)" = Battery ] && continue
	[ "$(cat "$s/online" 2>/dev/null)" = 1 ] && online=1
done
# No battery at all (VM, desktop): nothing to save
ls /sys/class/power_supply/*/capacity >/dev/null 2>&1 || exit 0

if [ $online = 1 ]; then
	powerprofilesctl set balanced
else
	powerprofilesctl set power-saver
fi
