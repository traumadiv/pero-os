#!/bin/sh
# pero-grub-install — grub-install for Calamares that survives tablet firmware.
#
# Cherry Trail 32-bit UEFI (and OVMF ia32 under a 64-bit kernel) often refuse
# EFI variable writes. The files are fine then, only the NVRAM entry is missing,
# so retry without it: Calamares' installEFIFallback puts the loader at
# EFI/BOOT/BOOT*.EFI, which the firmware boots on its own.
#
# On i386-efi Debian installs a plain core image whose prefix is only a
# partition number, "(,gpt2)/boot/grub", relative to the disk GRUB was started
# from. Cherry Trail firmware hands GRUB an eMMC device path it cannot map back
# to a disk, so the menu never loads and the tablet stops at the grub> prompt
# (`configfile /boot/grub/grub.cfg` gets it going by hand). So the loader is
# replaced with a standalone image that finds /boot by filesystem UUID and has
# every module the menu needs built in, and a grub.cfg stub goes next to it.
#
#   pero-grub-install <grub-install args>   what Calamares runs
#   pero-grub-install --refresh             rebuild the loader on an installed system
#                                           (apt runs it after GRUB upgrades)

GRUB=/usr/lib/grub/i386-efi
STAMP=/var/lib/pero/grub-ia32.stamp

# Modules for grub.cfg's own insmod lines; built in, so GRUB never loads
# modules from /boot that could be from another GRUB version.
MODULES="part_gpt part_msdos fat ext2 btrfs xfs iso9660 search search_fs_uuid
	search_fs_file search_label normal configfile linux boot echo test true
	loadenv regexp ls cat sleep gzio xzio lzopio zstd all_video efi_gop efi_uga
	video_bochs video_cirrus gfxterm gfxterm_background gfxmenu font png jpeg
	gettext chain halt reboot minicmd keystatus probe cpuid"

esp_dir() {
	for d in "$1" /boot/efi /efi; do
		[ -n "$d" ] && mountpoint -q "$d" && { echo "$d"; return; }
	done
}

# Build EFI/<id>/grubia32.efi and EFI/BOOT/BOOTIA32.EFI on the ESP
standalone_ia32() {
	esp=$(esp_dir "$1") id=${2:-debian}
	[ -n "$esp" ] && [ -e "$GRUB/kernel.img" ] || return 1
	# LUKS / LVM / RAID /boot needs grub-install's own cryptomount logic
	[ -z "$(grub-probe --target=abstraction /boot/grub 2>/dev/null)" ] || return 1
	uuid=$(grub-probe --target=fs_uuid /boot/grub) || return 1
	rel=$(grub-mkrelpath /boot/grub) || return 1

	tmp=$(mktemp -d)
	cat >"$tmp/early.cfg" <<EOF
search --no-floppy --fs-uuid --set=root $uuid
set prefix=(\$root)$rel
configfile \$prefix/grub.cfg
EOF
	# shellcheck disable=SC2086
	grub-mkimage -O i386-efi -d "$GRUB" -c "$tmp/early.cfg" -p "$rel" \
		-o "$tmp/grubia32.efi" $MODULES || { rm -rf "$tmp"; return 1; }

	# Same config as a stub for any other GRUB image that ends up in these directories
	for d in "$esp/EFI/$id" "$esp/EFI/BOOT"; do
		mkdir -p "$d"
		cp "$tmp/early.cfg" "$d/grub.cfg"
	done
	cp "$tmp/grubia32.efi" "$esp/EFI/$id/grubia32.efi"
	# FAT is case-insensitive; reuse whatever spelling is already there
	boot=$(find "$esp/EFI/BOOT" -maxdepth 1 -iname bootia32.efi | head -n1)
	cp "$tmp/grubia32.efi" "${boot:-$esp/EFI/BOOT/BOOTIA32.EFI}"

	# Dual-boot firmware (Alldocube's Windows/Android menu) starts Windows by
	# this fixed path. With no Windows left (no BCD), that entry boots Pero
	# too; a real Windows boot manager is never touched.
	ms="$esp/EFI/Microsoft/Boot"
	if ! find "$ms" -maxdepth 1 -iname bcd 2>/dev/null | grep -q .; then
		mkdir -p "$ms"
		mgr=$(find "$ms" -maxdepth 1 -iname bootmgfw.efi | head -n1)
		cp "$tmp/grubia32.efi" "${mgr:-$ms/bootmgfw.efi}"
		cp "$tmp/early.cfg" "$ms/grub.cfg"
	fi
	rm -rf "$tmp"

	mkdir -p "${STAMP%/*}"
	{ echo "$esp $id"; md5sum "$GRUB/kernel.img" | cut -d' ' -f1; } >"$STAMP"
	echo "pero-grub-install: standalone i386-efi loader in $esp/EFI/$id, EFI/BOOT and EFI/Microsoft/Boot (/boot UUID $uuid)" >&2
}

# Remove boot entries whose partition is gone, like Android's after "erase
# disk": the firmware keeps offering them in its OS menu. Only entries that
# name a GPT partition by UUID are judged; firmware built-ins are left alone.
drop_stale() {
	parts=$(lsblk -rno PARTUUID 2>/dev/null | tr 'A-F' 'a-f')
	esp_uuid=$(findmnt -no SOURCE "${efidir:-/boot/efi}" 2>/dev/null | xargs -r lsblk -no PARTUUID 2>/dev/null | tr 'A-F' 'a-f')
	# Without a trustworthy partition list nothing is "missing"
	[ -n "$esp_uuid" ] && echo "$parts" | grep -qx "$esp_uuid" || return 0
	efibootmgr -v 2>/dev/null | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} \(.*\)HD([0-9]*,GPT,\([0-9A-Fa-f-]*\),.*/\1 \3 \2/p' |
		while read -r n uuid label; do
			echo "$parts" | grep -qx "$(echo "$uuid" | tr 'A-F' 'a-f')" && continue
			efibootmgr -q -b "$n" -B 2>/dev/null &&
				echo "pero-grub-install: removed stale boot entry Boot$n ($label)" >&2
		done
	return 0
}

# Put Pero's entry (or the firmware's own "UEFI OS" fallback entry) first in
# BootOrder. Best effort: this firmware often refuses variable writes, and the
# order can always be set by hand in the BIOS Boot tab.
boot_first() {
	command -v efibootmgr >/dev/null || return 0
	drop_stale
	num=$(efibootmgr 2>/dev/null | awk -v id="$1" '
		/^Boot[0-9A-Fa-f]{4}/ {
			n = substr($1, 5, 4); sub(/\*$/, "", n)
			l = tolower($0)
			if (index(l, tolower(id)) || index(l, "pero")) { print n; exit }
			if (!u && index(l, "uefi os")) u = n
		}
		END { if (u) print u }' | head -n1)
	[ -n "$num" ] || return 0
	order=$(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: //p' | tr ',' '\n' | grep -vix "$num" | paste -sd, -)
	efibootmgr -q -o "$num${order:+,$order}" 2>/dev/null &&
		echo "pero-grub-install: Boot$num first in BootOrder" >&2
	return 0
}

if [ "$1" = "--refresh" ]; then
	# Only on systems this script set up, and only when GRUB itself changed
	[ -r "$STAMP" ] || exit 0
	[ "$(sed -n 2p "$STAMP")" = "$(md5sum "$GRUB/kernel.img" 2>/dev/null | cut -d' ' -f1)" ] && exit 0
	set -- $(sed -n 1p "$STAMP")
	standalone_ia32 "$1" "$2"
	exit 0
fi

target= efidir= id=
for a in "$@"; do
	case "$a" in
		--target=*) target=${a#*=} ;;
		--efi-directory=*) efidir=${a#*=} ;;
		--bootloader-id=*) id=${a#*=} ;;
	esac
done

grub-install "$@" || {
	echo "pero-grub-install: NVRAM write failed, retrying with --no-nvram" >&2
	grub-install "$@" --no-nvram || exit
}

if [ "$target" = i386-efi ]; then
	standalone_ia32 "$efidir" "$id" ||
		echo "pero-grub-install: kept grub-install's own loader" >&2
fi
case "$target" in *-efi) boot_first "${id:-debian}" ;; esac
exit 0
