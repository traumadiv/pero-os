[org.onboard]
layout='Compact'
theme='DarkRoom'
show-status-icon=false
start-minimized=true
use-system-defaults=false
key-label-font='Inter'

[org.onboard.auto-show]
enabled=true
hide-on-key-press=false

[org.onboard.window]
docking-enabled=true
docking-shrink-workarea=true
force-to-top=true
window-state-sticky=true

[org.onboard.window.landscape]
dock-height=320

[org.onboard.window.portrait]
dock-height=420

[org.onboard.typing-assistance.word-suggestions]
enabled=false

[org.gnome.desktop.interface]
toolkit-accessibility=true
gtk-theme='Orchis-Dark'
icon-theme='Papirus-Dark'
font-name='Inter 10'
color-scheme='prefer-dark'
